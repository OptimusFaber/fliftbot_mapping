{
  "profile": "odom_fixed",
  "purpose": "Wheel-anchored LiDAR map for real recordings",
  "trajectory_source": "absolute enc_* x,y,dgr from move logger",
  "lidar_model": {
    "frame": "sensor",
    "translation_body_m": [1.015, 0.0],
    "yaw_body_deg": -90.0,
    "fork_state": "down"
  },
  "registration": {
    "method": "scan_to_submap_icp",
    "submap_frames": 12,
    "absolute_odom_weight": 0.65,
    "icp_weight": 0.35,
    "max_icp_translation_m": 0.18,
    "max_icp_rotation_deg": 5.0,
    "max_range_m": 10.0,
    "min_overlap": 0.45,
    "max_rmse_m": 0.08
  },
  "map": {
    "cell_m": 0.05,
    "min_hits": 6,
    "min_component_cells": 40
  },
  "limitations": [
    "Per-beam timestamps are unavailable; only scan timestamps are used",
    "The profile assumes forks are down"
  ]
}
